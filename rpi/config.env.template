# =============================================================================
# RPI Cluster — Configuration Template
# =============================================================================
# INSTRUCTIONS:
#   1. Copy this file:  cp config.env.template config.env
#   2. Fill in every __FILL_IN__ with your actual values
#   3. Get IPs by running:  hostname -I   on each Pi
#
# config.env is gitignored and never committed.
# =============================================================================

# ── Master node ───────────────────────────────────────────────────────────────
MASTER_USER=rpi-master
MASTER_HOST=rpi-master.local
MASTER_IP=__FILL_IN__

# ── Worker nodes ──────────────────────────────────────────────────────────────
WORKER1_USER=rpi-worker1
WORKER1_HOST=rpi-worker1.local
WORKER1_IP=__FILL_IN__

WORKER2_USER=rpi-worker2
WORKER2_HOST=rpi-worker2.local
WORKER2_IP=__FILL_IN__

WORKER3_USER=rpi-worker3
WORKER3_HOST=rpi-worker3.local
WORKER3_IP=__FILL_IN__

WORKER4_USER=rpi-worker4
WORKER4_HOST=rpi-worker4.local
WORKER4_IP=__FILL_IN__

WORKER5_USER=rpi-worker5
WORKER5_HOST=rpi-worker5.local
WORKER5_IP=__FILL_IN__

# ── Paths (change only if your Pi layout differs) ────────────────────────────
# Remote workspace root on every node
RPI_WORKSPACE_DIR=~/workspace

# Where the game binary lives (must be the same path on all nodes for mpirun)
RPI_GAME_BIN=/tmp/game
